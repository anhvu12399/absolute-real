# ─────────────────────────────────────────────────────────────
# Identity — the only block that must change when cloning this
# front end for another WordPress site. See CLONE.md.
# ─────────────────────────────────────────────────────────────

# Public URL of THIS site. Drives canonical tags, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://www.absoluteasiatours.com

# Brand, as printed in breadcrumbs, the title template and seeded copy.
# The header and footer prefer WordPress's own site name; these cover the
# templates that have no site object to hand.
NEXT_PUBLIC_BRAND_NAME=Absolute Asia Tours
NEXT_PUBLIC_BRAND_SHORT=Absolute Asia
NEXT_PUBLIC_BRAND_TAGLINE=Private | Luxury | Journeys

# Homepage <title> and meta description. Leave blank to build them from the
# brand name.
NEXT_PUBLIC_SITE_TITLE=
NEXT_PUBLIC_SITE_DESCRIPTION=

# Old domains still linked to from imported article bodies. Anything listed
# here is rewritten to a local path, so a reader is never sent off-site
# mid-article. Comma separated, no protocol needed.
NEXT_PUBLIC_LEGACY_HOSTS=absoluteasiatours.com,mywaytravel.com

# Footer social row, as "Label|URL" pairs. Leave empty and the row is not
# rendered - better than linking to another company's profiles.
NEXT_PUBLIC_SOCIALS=Instagram|https://www.instagram.com/absoluteasiatours/,Facebook|https://www.facebook.com/absoluteasiatours,Pinterest|https://www.pinterest.com/absoluteasiatours/

# ─────────────────────────────────────────────────────────────
# WordPress connection
# ─────────────────────────────────────────────────────────────

# Where the bridge plugin lives. Required.
WORDPRESS_API_URL=https://backend.absoluteasiatours.com/wp-json
NEXT_PUBLIC_WP_URL=https://backend.absoluteasiatours.com

# Origin that wp-admin, uploads and sitemaps are proxied to.
WORDPRESS_ORIGIN=https://backend.absoluteasiatours.com

# Only when the WordPress origin serves per-host content and needs the public
# hostname spelled out in the request. Leave blank otherwise - a local backend
# 404s on a spoofed Host header.
WORDPRESS_HOST_HEADER=

# Shows an "Edit" button linking to the WordPress screen that edits the page
# you are looking at. Useful on staging; leave unset in production.
NEXT_PUBLIC_SHOW_EDIT_LINKS=

# Shared secret for the plugin's on-publish revalidation call.
WORDPRESS_REVALIDATE_SECRET=replace-with-a-long-random-secret

# Local development against backend/docker-compose.yml:
#   NEXT_PUBLIC_WP_URL=http://localhost:8081
#   WORDPRESS_API_URL=http://localhost:8081/wp-json

# ─────────────────────────────────────────────────────────────
# Lead form (optional — the form renders without these, but
# submissions are not delivered)
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
RESEND_API_KEY=re_xxxxxxxxx
LEAD_FROM_EMAIL=Absolute Asia Tours <website@example.com>
LEAD_TO_EMAIL=team@example.com
