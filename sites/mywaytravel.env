# ── My Way Travel ──
# Chưa dùng: điền địa chỉ backend rồi chạy `npm run site mywaytravel`.
NEXT_PUBLIC_SITE_URL=https://www.mywaytravel.com
NEXT_PUBLIC_BRAND_NAME=My Way Travel
NEXT_PUBLIC_BRAND_SHORT=My Way Travel
NEXT_PUBLIC_BRAND_TAGLINE=
# Logo: this brand has no vector mark in this repo - take it from the CMS.
NEXT_PUBLIC_BRAND_LOGO=wordpress

# Left blank on purpose: an unstated number or entity must print nothing
# rather than another company's.
NEXT_PUBLIC_BRAND_PHONE=
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_SITE_TITLE=
NEXT_PUBLIC_SITE_DESCRIPTION=
NEXT_PUBLIC_LEGACY_HOSTS=mywaytravel.com
NEXT_PUBLIC_SOCIALS=

NEXT_PUBLIC_WP_URL=https://backend.mywaytravel.com
WORDPRESS_API_URL=https://backend.mywaytravel.com/wp-json
WORDPRESS_ORIGIN=https://backend.mywaytravel.com
WORDPRESS_HOST_HEADER=

# Nút Edit trên web chỉ hiện với người đã đăng nhập WordPress — không còn cờ
# bật/tắt nào cả. Backend tự trả lời qua /absolute-asia/v1/me.

# Bí mật dùng chung cho việc đăng phát lên ngay. Đặt cùng giá trị này vào
# wp-config.php:
#   define('AAT_REVALIDATE_URL', '<NEXT_PUBLIC_SITE_URL>/api/revalidate');
#   define('AAT_REVALIDATE_SECRET', '<giá trị dưới đây>');
# Bỏ trống thì lưu bài xong web không tự cập nhật.
WORDPRESS_REVALIDATE_SECRET=
