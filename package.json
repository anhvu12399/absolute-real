{
  "name": "absolute-asia-headless",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "contract:check": "node scripts/validate-contract.mjs",
    "check": "npm run contract:check && npm run typecheck",
    "lighthouse": "node scripts/lighthouse.mjs",
    "site": "node scripts/site.mjs",
    "index:submit": "node scripts/google-index.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/leaflet": "^1.9.22",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "leaflet": "^1.9.4",
    "next": "latest",
    "postgres": "^3.4.7",
    "react": "latest",
    "react-dom": "latest",
    "react-leaflet": "^5.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "wrangler": "^4.124.0"
  }
}
